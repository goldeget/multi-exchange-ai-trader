[Unit]
Description=DEMO account monitor only (native trading remains blocked)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/opt/trader/app
# Separate root-owned 0600 nonsecret file; see monitor-worker.env.example.
# Share explicit credential/profile store paths with the API's runtime.env.
# The selected complete saved profile supplies expectations for genuine authentication.
# TRADER_MONITOR_SYMBOL is an observation target, never capital or strategy approval.
EnvironmentFile=/etc/trader/monitor-worker.env
# Optional fixed /etc/trader/policy-target.json is shared with the separate API.
# A present target must match --policy-db below; disagreement rejects before auth.
# This inactive template neither creates the config nor enables entry/admission.
# No shell interpolation, server port, strategy plugin, or automatic order activation.
# Co-locate execution.sqlite3/runtime-state.sqlite3 with policy and app ledgers for offline recovery.
# Explicit monitor selects the DEMO credential namespace, never order qualification.
# Missing DEMO fee lookup remains UNKNOWN and cannot authorize financial use.
ExecStart=/usr/bin/env LIVE_TRADING_ENABLED=false BYBIT_DEMO=true BYBIT_TESTNET=false BYBIT_ENV_FILE=off AI_ENV_FILE=off ANTHROPIC_ENV_FILE=off /opt/trader/app/.venv/bin/python -m multi_exchange_trader.execution.worker_cli --run-monitor --connect-monitoring --observation-fee-profile SDK1231_OBSERVATION_UNKNOWN_FEES_V1 --symbol ${TRADER_MONITOR_SYMBOL} --directory /var/lib/trader/data --policy-db /var/lib/trader/data/runtime-policy.sqlite3 --lock-directory /var/lib/trader/locks
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillMode=control-group
LimitCORE=0
UMask=0077
StateDirectory=trader trader/locks
StateDirectoryMode=0700
ReadWritePaths=/var/lib/trader
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
