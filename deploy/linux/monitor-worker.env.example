# No secrets. Review paths before copying to /etc/trader/monitor-worker.env, mode 0600.
# These are the same persistent registration files used by the API's runtime.env.
# Registration and an adopted complete DEMO profile are required before monitoring.
# Never put API keys, UID tuples, capital, or strategy approvals in this file.
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
TMPDIR=/var/lib/trader/tmp
XDG_CACHE_HOME=/var/lib/trader/cache
TRADER_CREDENTIAL_FILE=/var/lib/trader/private/credentials.json
TRADER_ACCOUNT_PROFILE_FILE=/var/lib/trader/private/account-profiles.json
# Example observation target only; this does not authorize an order or allocation.
TRADER_MONITOR_SYMBOL=BTCUSDT
LIVE_TRADING_ENABLED=false
BYBIT_DEMO=true
BYBIT_TESTNET=false
BYBIT_ENV_FILE=off
ANTHROPIC_ENV_FILE=off
AI_ENV_FILE=off
