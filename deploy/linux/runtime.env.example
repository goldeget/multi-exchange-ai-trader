# No secrets. Copy deliberately after reviewing every path; systemd syntax.
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
TMPDIR=/var/lib/trader/tmp
XDG_CACHE_HOME=/var/lib/trader/cache
PAPER_DB_PATH=/var/lib/trader/data/paper.sqlite3
PAPER_SPOT_DB_PATH=/var/lib/trader/data/spot-paper.sqlite3
PAPER_REVIEW_DB_PATH=/var/lib/trader/data/order-reviews.sqlite3
AI_DB_PATH=/var/lib/trader/data/ai.sqlite3
RECOMMENDATION_DB_PATH=/var/lib/trader/data/recommendations.sqlite3
PHASE4_DB_PATH=/var/lib/trader/data/research.sqlite3
PHASE4_DATA_ROOT=/var/lib/trader/data/datasets
LIVE_TRADING_ENABLED=false
BYBIT_DEMO=false
BYBIT_TESTNET=false
BYBIT_ENV_FILE=off
ANTHROPIC_ENV_FILE=off
# Block every currently configured public market host in this offline preparation.
MARKET_DATA_BLOCKED_HOSTS=data-api.binance.vision,fapi.binance.com,api.bybit.com,www.okx.com
# OFFLINE_TEST / llm_enabled=false are application invariants, not invented env switches.
